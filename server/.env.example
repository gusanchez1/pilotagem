# ─────────────────────────────────────────────────────────────
# PILOTAGEM — configuração da API
# Copie para .env (ou execute `npm run setup` na raiz do projeto)
# ─────────────────────────────────────────────────────────────

# Porta da API
PORT=4000

# Conexão com o MongoDB local (Community Server)
# Use 127.0.0.1 em vez de localhost (evita problemas de IPv6 no Windows/macOS)
MONGODB_URI=mongodb://127.0.0.1:27017/pilotagem

# Banco usado apenas pelos testes automatizados (é apagado a cada execução de teste)
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/pilotagem_test

# Segredo para assinar os tokens JWT. `npm run setup` gera um valor aleatório.
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Endereço do frontend em desenvolvimento (CORS)
CLIENT_URL=http://localhost:5173

# Permite que o administrador restaure os dados de demonstração pela interface
ALLOW_DEMO_RESET=true

# Fuso horário de referência do negócio
APP_TIMEZONE=America/Sao_Paulo
