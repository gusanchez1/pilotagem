# ─────────────────────────────────────────────────────────────
# PILOTAGEM — configuração do frontend
# ─────────────────────────────────────────────────────────────

# Endereço da API. Em desenvolvimento o Vite redireciona /api para http://localhost:4000,
# então normalmente não é preciso alterar.
VITE_API_URL=/api

# Endereço usado pelo proxy do Vite em desenvolvimento
VITE_PROXY_TARGET=http://localhost:4000

# Mostra os botões de "acesso rápido" com as contas de demonstração na tela de login
VITE_SHOW_DEMO_LOGINS=true
